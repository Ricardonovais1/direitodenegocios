# Sanity CMS — create a project at https://sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=your_sanity_read_token

# Resend — email delivery for contact forms (https://resend.com)
RESEND_API_KEY=re_your_api_key
RESEND_TO_EMAIL=contact@yourfirm.com
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Google Analytics 4 — paste your Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Live chat — set provider to "tawkto" or "crisp", then add the ID
NEXT_PUBLIC_LIVE_CHAT_PROVIDER=tawkto
NEXT_PUBLIC_TAWKTO_ID=your_tawkto_property_id/widget_id
NEXT_PUBLIC_CRISP_ID=your_crisp_website_id

# Canonical site URL (used for OG metadata and sitemap)
NEXT_PUBLIC_SITE_URL=https://yourfirm.com
